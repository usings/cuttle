Section SS = ss, sec.example.com, 443, encrypt-method=chacha20-ietf-poly1305, password="pass", udp-relay=true
Section SS 2 = ss, sec.example.com, 8443, encrypt-method=aes-256-gcm, password="pass2", udp-relay=true

· ss:surge-line
Surge SS = ss, sg.example.com, 443, encrypt-method=aes-256-gcm, password="pass", udp-relay=true

