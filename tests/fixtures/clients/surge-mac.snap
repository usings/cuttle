Loon SS = ss, ln.example.com, 443, encrypt-method=aes-256-gcm, password="pass", udp-relay=true

· ss:mihomo-yaml
YAML SS = ss, example.com, 443, encrypt-method=aes-256-gcm, password="password", udp-relay=true

· ss:plugin-obfs
SS OBFS = ss, example.com, 443, encrypt-method=aes-256-gcm, password="password", obfs=http, obfs-host=cdn.example.com, udp-relay=false

