proxies:
  - type: vmess
    name: VMess gRPC
    server: example.com
    port: 443
    uuid: 01890d4e-7d8d-7d0c-98fb-123456789abc
    alterId: 0
    cipher: auto
    network: grpc
    tls: true
    udp: true
    grpc-opts:
      grpc-service-name: grpcsvc
    servername: example.com

