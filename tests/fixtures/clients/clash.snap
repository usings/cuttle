proxies:
  - type: trojan
    name: Trojan gRPC
    server: example.com
    port: 443
    network: grpc
    udp: true
    password: password
    grpc-opts:
      grpc-service-name: edge
    sni: example.com

· trojan:httpupgrade
proxies: []
! Upgrade (trojan/httpupgrade) cannot be carried by clash; skipped.

· trojan:no-udp
proxies:
  - name: Trojan NoUDP
    type: trojan
    server: example.com
    port: 443
    password: password
    udp: false
    skip-cert-verify: true
    network: tcp
    sni: example.com

