· ssr:uri
proxies:
  - type: ssr
    name: SSR Node
    server: ssr.example.com
    port: 8388
    protocol: auth_aes128_md5
    cipher: aes-256-cfb
    obfs: tls1.2_ticket_auth
    password: password
    protocol-param: "64"
    obfs-param: cdn.example.com
    udp: true

