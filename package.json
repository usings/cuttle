{
  "name": "cuttle",
  "version": "0.0.1",
  "private": true,
  "description": "Universal proxy node converter.",
  "type": "module",
  "scripts": {
    "serve:dev": "vite dev",
    "serve:preview": "pnpm run build && vite preview",
    "check:code": "oxlint && oxfmt --check",
    "check:type": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --pass-with-no-tests",
    "typegen:worker": "wrangler types ./wrangler.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "build": "vite build",
    "deploy": "pnpm run build && wrangler deploy",
    "release": "bumpp"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^9.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bumpp": "^12.3.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "shadcn": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  },
  "packageManager": "pnpm@11.28.9"
}
