{
  "name": "cuttle",
  "version": "0.0.0",
  "private": true,
  "description": "Universal proxy node converter.",
  "type": "module",
  "scripts": {
    "serve:dev": "vite dev",
    "serve:preview": "pnpm run build && vite preview",
    "check:code": "oxlint && oxfmt --check",
    "check:type": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --pass-with-no-tests",
    "typegen:worker": "wrangler types ./wrangler.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "build": "vite build",
    "deploy": "pnpm run build && wrangler deploy",
    "release": "bumpp"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-start": "^1.168.48",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-table": "^9.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "bumpp": "^12.2.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "shadcn": "^4.18.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  },
  "packageManager": "pnpm@11.22.0"
}
